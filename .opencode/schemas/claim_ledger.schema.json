{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourced claim ledger",
  "type": "object",
  "required": [
    "schema_version",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "source_ids",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "unverified",
              "supported",
              "qualified",
              "rejected"
            ]
          }
        }
      }
    }
  }
}
