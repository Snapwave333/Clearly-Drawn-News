  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "vite": "8.3.4",
    "wait-on": "9.0.4"
  }
}
